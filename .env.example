# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgresql://did_user:did_pass_dev@localhost:5432/decentralized_id
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=did_user
DB_PASSWORD=did_pass_dev
DB_NAME=decentralized_id
DB_POOL_SIZE=20

# ==========================================
# Redis Configuration
# ==========================================
REDIS_URL=redis://:did_redis_dev@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=did_redis_dev
REDIS_DB=0

# ==========================================
# MinIO/S3 Configuration (Status List Storage)
# ==========================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret_dev
S3_BUCKET=status-lists
S3_REGION=us-east-1
S3_USE_SSL=false

# ==========================================
# Vault/KMS Configuration (Issuer Private Key)
# ==========================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_KEY_PATH=secret/data/issuer-key
# Production: use AWS KMS or HSM
# KMS_KEY_ARN=arn:aws:kms:ap-southeast-1:123456789:key/xxx

# ==========================================
# DID Configuration
# ==========================================
# Issuer DID (did:web format)
ISSUER_DID=did:web:issuer.example.ac.id
ISSUER_DOMAIN=https://issuer.example.ac.id
ISSUER_NAME=Example University

# DID Method (web | ion)
DID_METHOD=web

# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT_ISSUER=3001
PORT_VERIFIER=3002

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# ==========================================
# Security Configuration
# ==========================================
# JWT secret untuk session management (NOT for VC signing!)
JWT_SECRET=replace-with-strong-secret-min-32-chars-use-openssl-rand

# Nonce/Challenge TTL
NONCE_TTL_SECONDS=300
PRESENTATION_CHALLENGE_TTL_SECONDS=600

# Rate Limiting
RATE_LIMIT_ISSUE_VC=10
RATE_LIMIT_ISSUE_TTL=60000
RATE_LIMIT_VERIFY_VP=50
RATE_LIMIT_VERIFY_TTL=60000

# ==========================================
# Credential Configuration
# ==========================================
# Default VC expiration (days)
VC_DEFAULT_EXPIRATION_DAYS=730

# StatusList2021 configuration
STATUS_LIST_SIZE=131072
STATUS_LIST_REFRESH_INTERVAL=900000

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=debug
LOG_FORMAT=json
# Sanitize PII in logs
LOG_SANITIZE_PII=true

# ==========================================
# Admin Portal (Next.js)
# ==========================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-another-secret-min-32-chars

# Admin authentication
ADMIN_EMAIL=admin@example.ac.id
ADMIN_PASSWORD_HASH=

# ==========================================
# Mobile Wallet Deep Link
# ==========================================
WALLET_DEEPLINK_SCHEME=decentralizedid
WALLET_DEEPLINK_HOST=presentation

# ==========================================
# Monitoring (Optional)
# ==========================================
# SENTRY_DSN=
# PROMETHEUS_PORT=9090
